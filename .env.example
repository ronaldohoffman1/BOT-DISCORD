# ==========================================
# Configurações do Bot do Discord da Guilda
# ==========================================

# Token do Bot gerado no Discord Developer Portal (Seção "Bot" -> "Reset Token")
DISCORD_TOKEN=seu_token_aqui

# Application ID / Client ID do Bot (Seção "General Information")
CLIENT_ID=seu_client_id_aqui

# ID do seu Servidor do Discord (Guild ID)
# Opcional, mas altamente recomendado: ao colocar aqui, os slash commands são registrados INSTANTANEAMENTE no seu servidor!
GUILD_ID=seu_server_id_aqui
